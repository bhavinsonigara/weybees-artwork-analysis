GEMINI_API_KEY=AIza...
# gemini-2.5-flash is the demo default — strongest noise rejection AND
# signature transcription on our test set. If your AI Studio project
# free-tier RPD is too tight (new projects can be as low as 20 RPD),
# fall back to gemini-2.5-flash-lite which has a much higher RPD but
# noticeably weaker stylised-handwriting OCR.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
# Gemini 2.5 models use "thinking" tokens by default; we disable for clean JSON output.
# Set to 0 to re-enable (note: max_output_tokens will then need to be much larger).
GEMINI_DISABLE_THINKING=1

REDIS_URL=redis://redis:6379/0
SQLITE_PATH=/app/data/history.sqlite3

ARTWORK_SERVICE_URL=http://artwork:8001
SIGNATURE_SERVICE_URL=http://signature:8002

VISION_CACHE_TTL_SECONDS=2592000
LOG_LEVEL=INFO
